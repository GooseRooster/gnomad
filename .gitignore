# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Pending insta snapshots (reviewed and accepted with `cargo insta accept`)
*.snap.new

/target

# Release tarballs built by scripts/release.sh
*.tar.gz

# direnv / per-developer dev shell hook
/.direnv/
/.envrc.local
